{
    "$schema":  "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
    "metadata":  [
                     {
                         "src":  [
                                     {
                                         "src":  "..",
                                         "files":  [
                                                       "src/Pmcro.Runtime/Pmcro.Runtime.csproj"
                                                   ]
                                     }
                                 ],
                         "dest":  "api"
                     }
                 ],
    "build":  {
                  "content":  [
                                  {
                                      "files":  [
                                                    "**/*.{md,yml}"
                                                ],
                                      "exclude":  [
                                                      "_site/**",
                                                      "docs/**"
                                                  ]
                                  }
                              ],
                  "resource":  [
                                   {
                                       "files":  [
                                                     "images/**"
                                                 ]
                                   }
                               ],
                  "output":  "_site",
                  "template":  [
                                   "default",
                                   "modern"
                               ],
                  "globalMetadata":  {
                                         "_appName":  "PMCR-O",
                                         "_appTitle":  "Tooensure / PMCR-O Agent Company",
                                         "_enableSearch":  true,
                                         "pdf":  false
                                     }
              }
}
